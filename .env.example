# ─────────────────────────────────────────────────────────────────
# Environment Variables — copy to .env and fill in values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────

# App
ENVIRONMENT=development
DEBUG=true

# Database (dev: SQLite, prod: PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./marketprophet.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/marketprophet

# Redis (leave empty to disable caching in dev)
REDIS_URL=redis://localhost:6379

# External APIs
COINGECKO_API_KEY=        # optional — free tier works without it

# Comma-separated list the backend accepts CORS requests from.
# pydantic-settings expects a JSON array for list-typed env vars:
ALLOWED_ORIGINS=["http://localhost:5173"]

# Frontend — see frontend/.env.example (VITE_API_BASE_URL)
